APP_NAME=索克家居
APP_VERSION=1.13.1
DEBUG=false

# ─────────────────────────────────────────────────────────────
# 数据库：阿里云 PolarDB for PostgreSQL（100% 兼容 PG 协议）
# ─────────────────────────────────────────────────────────────
# 推荐配置：PolarDB-PG 集群版（主备高可用）+ 通用型 4 核 8GB 起步
# 字符集：UTF8 | 时区：Asia/Shanghai（与 Python 应用层一致）
# 网络：建议与 ECS 同 VPC 内网访问（pc-xxxxx.pg.rds.aliyuncs.com:5432）
# SSL：PolarDB 默认支持 SSL，内网访问可关闭（?sslmode=disable），公网必须启用（?sslmode=require）
#
# 格式：postgresql+asyncpg://{user}:{password}@{host}:{port}/{dbname}?{params}
# 示例：
DATABASE_URL=postgresql+asyncpg://ihome:strong-password@pc-xxxxx.pg.rds.aliyuncs.com:5432/ihome?sslmode=require
#
# 本地开发回退（仅 DEBUG 用）：
# DATABASE_URL=sqlite+aiosqlite:///./data/ihome.db
#
# 连接池调优（asyncpg 默认池大小 5，生产建议通过 uvicorn --workers 控制）：
#   - 单 worker 模式：进程内 asyncpg 自动管理连接池，建议 max_size=20
#   - 多 worker 模式（--workers 4）：总连接数 = 4 × 20 = 80，需确保 PolarDB max_connections ≥ 100
#
# 兼容性说明（代码层零改动）：
#   - 所有模型主键使用 String(36) + Python uuid4()（避免 PG 原生 UUID 类型依赖）
#   - JSON 字段自动映射为 JSONB（性能更好，支持 GIN 索引）
#   - 外键约束 PG 严格检查，迁移前需确保数据完整性
#   - app/database.py 已通过 if "sqlite" in url 自动切换 StaticPool（仅 SQLite）

# ─────────────────────────────────────────────────────────────
# Redis：阿里云 Tair（Redis 兼容版）/ 云数据库 Redis 版
# ─────────────────────────────────────────────────────────────
# 推荐配置：Tair 持久化版 1GB 起步（含 RDB+AOF 双持久化）
# 网络：与 ECS 同 VPC 内网访问（r-xxxxx.redis.rds.aliyuncs.com:6379）
# 鉴权：阿里云 Redis 默认开启 ACL，密码格式为 {user}:{password}
#
# 格式：redis://:{password}@{host}:{port}/{db}  或  redis://{user}:{password}@{host}:{port}/{db}
# 示例（默认账号 default）：
REDIS_URL=redis://default:strong-password@r-xxxxx.redis.rds.aliyuncs.com:6379/0
#
# 留空则使用内存字典降级（单 worker 开发模式可用，多 worker 部署必须启用）
# 使用场景：
#   1. WebAuthn 挑战存储（app/services/webauthn_service.py）
#   2. 健康检查 /health 自动 ping（app/main.py）
#   3. 未来：API 限流、会话缓存、分布式锁

# PASETO 密钥（生产环境务必使用强随机密钥，至少 32 字节）
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
PASETO_SECRET_KEY=please-replace-with-strong-random-key
# v1.8.2 P2.5: Token 撤销列表 Redis 化（多 worker 必需）
# False（默认）= 进程内 dict（FC 单实例场景 OK，logout 仅当前 worker 生效）
# True = Redis 共享撤销列表（多 worker 必需），Redis 不可用时 best-effort 降级到内存
PASETO_REVOCATION_REDIS_ENABLED=false
PASETO_REVOCATION_REDIS_URL=  # 如 redis://localhost:6379/0，留空则降级到内存

# DeepSeek API（留空使用 mock 模式）
# 模型名必须全小写: deepseek-v4-pro / deepseek-v4-flash / deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# GLM (智谱 AI)（余额不足时留空）
GLM_API_KEY=
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-plus

# Qwen-Audio-3.0-Realtime (阿里云百炼 DashScope)
QWEN_AUDIO_API_KEY=
QWEN_AUDIO_MODEL=qwen-audio-3.0-realtime-flash
QWEN_AUDIO_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_AUDIO_VOICE=cherry
VOICE_EMOTION_DETECTION=true
AGENT_FUNCTION_CALL_ENABLED=true
# v1.13.0 工具纪律（2026 前沿对齐）：执行前契约校验 + 并行工具执行
TOOL_ARGUMENT_VALIDATION_ENABLED=true
PARALLEL_TOOL_CALLS_ENABLED=true
VOICE_TURN_DETECTION=server_vad
VOICE_AUDIO_PROMPT_ENABLED=false

# 高德地图 Web API Key
AMAP_API_KEY=

# WebAuthn / Passkey
# WEBAUTHN_ENABLED: 全局开关，关闭后所有 WebAuthn 端点返回 503
# RP ID 必须与 Origin 的 host 完全一致（WebAuthn 规范要求）
# 注意: WebAuthn 要求 Secure Context (HTTPS 或 localhost)
# 多 origin 用逗号分隔: "https://app.i-home.life,https://api.i-home.life"
# 注意: 键名必须是复数 WEBAUTHN_ORIGINS（对齐 config.py webauthn_origins 字段）；
#       单数 WEBAUTHN_ORIGIN 会被 pydantic-settings 静默忽略，回退默认 http://localhost:8766
# 生产（i-home.life 域名切换后）参考值:
#   WEBAUTHN_RP_ID=i-home.life
#   WEBAUTHN_ORIGINS=https://i-home.life,https://www.i-home.life
WEBAUTHN_ENABLED=true
WEBAUTHN_RP_ID=your-host-or-ip
WEBAUTHN_ORIGINS=https://your-host
WEBAUTHN_CHALLENGE_TTL=120

# CORS 允许的来源（生产参考值，逗号分隔 JSON 数组）
#   ["https://i-home.life","https://www.i-home.life","https://i-home.life:8081"]
CORS_ORIGINS=["https://your-host"]

# v1.2.9 Workbench 上下文自适应建议（GenUI-lite：按时段重排快捷输入）
WORKBENCH_ADAPTIVE_SUGGESTIONS_ENABLED=false

# ── v1.3.0 新增 feature flag（MCP 2026-07-28 对齐 + 缓存硬约束 + v1.2.8 flag 补齐）──
# v1.2.8 悬浮窗常驻语音交互 + 讨论式方案交互
VOICE_FLOATING_WIDGET_ENABLED=true
DESIGN_PROPOSAL_LLM_ENABLED=true
# Console V2 灰度中，生产保持 false
CONSOLE_V2_ENABLED=false
# MCP 2026-07-28 完整对齐子开关（受 MCP_ENABLED 总开关约束）
MCP_DISCOVER_ENABLED=true
MCP_MRTR_ENABLED=true
MCP_TASKS_EXTENSION_ENABLED=true
# 缓存用户隔离硬约束（v1.3.0 强制开启；紧急回滚设 false）
CACHE_USER_ISOLATION_STRICT=true
# AI 渲染接入契约（P3，详见 app/services/ai_render_service.py）
AI_RENDER_BACKEND_TYPE=controlnet
AI_RENDER_CONTRACT_STRICT=true

# ── v1.9.0 前沿研究 2026 第二轮落地（6 项 flag 灰度，默认 false 零回归）──
# P0 AI 生成内容标识合规（显式标识 + 隐式水印元数据预埋）
AI_CONTENT_LABELING_ENABLED=false
# 高 MCP 安全硬化（SSRF 拦截 / 工具投毒校验 / 敏感字段清洗）
MCP_SECURITY_HARDENING_ENABLED=false
# 高 OTel GenAI SemConv 埋点（W3C traceparent/tracestate/baggage）
OTEL_GENAI_SEMCONV_ENABLED=false
# 高 GB/Z 185 智能体身份码/ACDL 预研（GET /api/agents/identity/{name}）
GBZ185_AGENT_CARD_ENABLED=false
# 中 Matter/GB-T 46456 智能家居协议兼容矩阵
SMART_PROTOCOL_COMPLIANCE_ENABLED=false
# 中 商业运营 Agent 记忆冲突门控（防记忆漂移/投毒）
MEMORY_CONFLICT_GATE_ENABLED=false

# ── v1.10.0 全链路诊断系统（2 项 flag 灰度，默认 false 零回归）──
# 总开关：Trace/快照/告警/建议 + /api/diagnostics/* 管理端（非 admin 403，未启用 503）
DIAGNOSTICS_ENABLED=false
# 前端 RUM（Core Web Vitals）采集（依赖总开关）
DIAGNOSTICS_RUM_ENABLED=false

# ── v1.10.1 Agent 自进化管线（3 项 flag 独立灰度，默认全 false 零回归）──
# 借鉴 EverMind EverOS Agent Memory + SkillCorpus + HarnessBank
# P0: 从 AgentTrace 自动提取结构化 Case（task_intent + approach + quality_score）
AGENT_CASE_EXTRACTION_ENABLED=false
# P1: Case 聚类蒸馏为 Skill + Agent 执行前检索注入同类 Case/Skill
AGENT_SKILL_DISTILLATION_ENABLED=false
# P1: Skill 随成败进化（三维质控 Utility/Robustness/Safety + WHERE×WHY 诊断归因）
AGENT_SKILL_EVOLUTION_ENABLED=false
