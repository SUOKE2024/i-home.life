{
  "ontology": "agent",
  "version": "1.0.0",
  "aligned_with": ["GB/Z 185-2026 ACDL 能力描述思路"],
  "description": "索克家居 Agent 能力本体：25 Agent + 1 Orchestrator 的能力/审批边界/分类。确定性知识基座，供 agent_identity_card 与治理审计引用。",
  "categories": {
    "orchestration": "总控编排",
    "execution": "执行型（面向用户交付）",
    "business_ops": "商业运营型（平台自身运营）"
  },
  "agents": [
