APP_NAME=i-home.life
APP_VERSION=1.2.8
DEBUG=true

# 数据库: 开发用 SQLite, 生产切换 PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./data/ihome.db
# 生产 PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/ihome

# Redis 缓存（留空禁用，使用内存字典降级）
# ⚠️ 多 worker 部署必须配置 Redis！WebAuthn 挑战存储在内存中不跨进程共享，
#    留空时多 worker 下注册/登录可能随机失败。单 worker 开发环境可留空。
REDIS_URL=
# 生产: redis://localhost:6379/0
# TLS:  rediss://user:pass@host:6380/0

# 对象存储 OSS（留空使用本地文件存储）
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=ihome-assets
OSS_REGION=cn-hangzhou

# 向量数据库 RAG（留空禁用语义检索）
VECTOR_DB_URL=
VECTOR_DB_COLLECTION=ihome_knowledge
# Qdrant: http://localhost:6333
# Milvus: http://localhost:19530

PASETO_SECRET_KEY=please-generate-a-strong-random-key-at-least-32-bytes
# PASETO_STRICT_MODE: True=无论 debug 都硬校验密钥（生产默认），False=开发环境放宽
PASETO_STRICT_MODE=false

# DeepSeek V4 API 配置（留空使用 mock 模式，填入真实 key 启用 LLM 调用）
# 模型名必须全小写: deepseek-v4-pro / deepseek-v4-flash / deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# GLM (智谱 AI) API 配置（可选，与 DeepSeek 互为补充；余额不足时留空）
GLM_API_KEY=
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-plus

# Qwen-Audio-3.0-Realtime (阿里云百炼 DashScope)
# 字段名必须为 QWEN_AUDIO_API_KEY (与 app/config.py 对齐)，DASHSCOPE_API_KEY 不会被读取
# 留空则语音服务走 mock 模式 (ASR/TTS/双工)
QWEN_AUDIO_API_KEY=
QWEN_AUDIO_MODEL=qwen-audio-3.0-realtime-flash
# 官方推荐业务空间专属域名（性能/稳定性更优）：
#   wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
# model 查询参数由后端自动注入，请勿在此拼接 ?model=。
QWEN_AUDIO_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_AUDIO_VOICE=cherry
# 音频格式契约：输入 16kHz/16bit/单声道 PCM，输出 24kHz/16bit/单声道 PCM
VOICE_INPUT_AUDIO_FORMAT=pcm
VOICE_OUTPUT_AUDIO_FORMAT=pcm
# 主动关怀：用户静默 N 毫秒后模型主动追问（Omni-Realtime server_vad 生效，Audio-Realtime 可能忽略；0=关闭）
VOICE_IDLE_TIMEOUT_MS=0
# 场景画像：default | site(工地:flash+smart_turn+声纹) | support(客服共情:plus+主动关怀) | elderly(养老:plus+问候)
VOICE_SCENARIO=default

# 高德地图 Web API Key（用于地址智能补全、定位）
AMAP_API_KEY=

# 阿里云身份证实名认证 AppCode（留空使用 Mock 模式，不调用真实核验）
ALIYUN_ID_VERIFY_APPCODE=

# WebAuthn / Passkey 生物识别认证
# WEBAUTHN_ENABLED: 全局开关，关闭后所有 WebAuthn 端点返回 503
# RP ID 必须与 WEBAUTHN_ORIGINS 的 host 一致（WebAuthn 规范要求）
# 开发环境: localhost / http://localhost:8766
# 生产环境: 域名或 IP / https://your-host
# 注意: WebAuthn 要求 Secure Context (HTTPS 或 localhost)，HTTP 模式下 Passkey 不可用
# 多 origin 用逗号分隔: "https://app.i-home.life,https://api.i-home.life"
WEBAUTHN_ENABLED=true
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:8766
WEBAUTHN_CHALLENGE_TTL=120
# 注意: 多 worker 部署时务必启用 REDIS_URL，否则挑战不共享会导致登录失败

# ── Feature Flags（开发环境默认设置，生产按需调整）──

# AI 渲染
AI_RENDER_ENABLED=true
REAL_AI_RENDER_ENABLED=false
AI_RENDER_BACKEND_URL=

# 语音
VOICE_EMOTION_DETECTION=true
VOICE_DUPLEX_MODE=true
VOICE_AUDIO_PROMPT_ENABLED=false
VOICE_EMOTION_ROUTING_ENABLED=true
VOICE_LLM_ROUTING_ENABLED=true
# 语音智能体编排：让 Realtime 模式 LLM 自主调用 launch_agent_task 后台执行多任务
# 借鉴 Qwen-Audio-3.0-Realtime "能聊天更能办事" 范式（v1.2.7 灰度开启）
VOICE_AGENT_ORCHESTRATION_ENABLED=false
# v1.2.8 悬浮窗常驻语音交互 + 讨论式方案交互
# 悬浮窗：Flutter 端 flag，控制 AuthGate 登录后是否注入 VoiceOverlayWidget
VOICE_FLOATING_WIDGET_ENABLED=false
# 讨论式方案：LLM 生成 2-3 套方案 + 语音调整修订（generate/update_design_proposal 工具）
DESIGN_PROPOSAL_LLM_ENABLED=false
TTS_ENABLED=true

# Agent
AGENT_FUNCTION_CALL_ENABLED=true
TOOL_REAL_DATA_ENABLED=true
AGENTIC_RAG_ENABLED=true
AGENT_LEARNING_ENABLED=true
AGENT_EVOLUTION_ENABLED=true
LLM_FALLBACK_ENABLED=true
HARNESS_TRACE_ENABLED=true

# 前端渲染
FILAMENT_ENABLED=true
OPENCASCADE_ENABLED=true
A2UI_ENABLED=true
CONSOLE_V2_ENABLED=false

# BIM / 施工图
FORWARD_TAKEOFF_ENABLED=true
BOM_FROM_GEOMETRY_ENABLED=true
QUOTA_LIBRARY_ENABLED=true
IFC_REAL_PLACEMENT_ENABLED=true
CONSTRUCTION_DRAWING_ENABLED=true
PARAMETRIC_CAD_ENABLED=true

# 空间智能（默认关闭，需要视觉模型）
SPATIAL_PERCEPTION_ENABLED=false
SPATIAL_REASONING_ENABLED=false
SPATIAL_INTERACTION_ENABLED=false
# 手绘草图 AI 视觉识别（v1.2.4）：开启后使用多模态模型分析草图，关闭返回占位
SKETCH_TO_3D_VISION_ENABLED=true

# 智能家居
MATTER_ENABLED=true
ENERGY_MONITOR_ENABLED=true
HEALTH_MONITOR_ENABLED=true
PREDICTIVE_SCENE_ENABLED=true
PREDICTIVE_MAINTENANCE_ENABLED=true

# 合规审计
AUDIT_LOG_ENABLED=true
AUDIT_HMAC_ENABLED=true
PII_MASKING_ENABLED=true

# 协议集成
MCP_ENABLED=true
A2A_ENABLED=true
INTEGRATION_EVENT_BUS_ENABLED=true

# 评估框架
EVAL_ENABLED=true
MODEL_SPEC_ENABLED=true
INTENT_VALIDATION_ENABLED=true
DSPY_ENABLED=false

# 基础设施
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BENCH_TOKEN=
CACHE_DECORATORS_ENABLED=true
SLOW_QUERY_LOG_ENABLED=true
SLOW_QUERY_EXPLAIN_ENABLED=false
TRACING_ENABLED=false

# 业务
DELIVERY_TRACKING_ENABLED=true
PUSH_ENABLED=true
# 推送提供商（逗号分隔，优先级从左到右）：fcm, apns, webpush, sms
# 留空 = mock 模式，所有推送走本地日志不实际发送
# 生产示例: PUSH_PROVIDER=fcm,apns
PUSH_PROVIDER=
HEALTH_OS_ENABLED=true
KNOWLEDGE_BASE_ENABLED=true
WATERPROOF_STRICT_CHECK=true
SECRET_MANAGER_ENABLED=true

# 其他
ALLOW_PLAINTEXT_SESSION=false
REAL_EMBEDDING_ENABLED=false
SERVICE_ROLE=
